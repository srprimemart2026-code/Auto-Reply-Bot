<a class="float" id="floatWa" href="#" target="_blank" rel="noopener">💬 <span>WhatsApp</span></a>
<div id="toast"></div>

<script>
/* =========================================================
   ⚙️ CONFIG — এই অংশটুকু আপনার তথ্য দিয়ে বদলে নিন
   ========================================================= */
const CONFIG = {
  // WhatsApp নম্বর — দেশের কোড সহ, + বা স্পেস ছাড়া
  // উদাহরণ: 01712345678 হলে লিখুন "8801712345678"
  whatsapp: "8801700000000",

  // আপনার Facebook Page-এর Messenger লিংক
  // উদাহরণ: https://m.me/yourpagename
  messenger: "https://m.me/yourpage",

  // ফোন (দেখানোর জন্য)
  phone: "+8801700000000",

  // দাম (টাকা)
  prices: { light: 200, necklace: 200 },

  // ডেলিভারি চার্জ
  delivery: { inside: 70, outside: 130 },

  // পণ্যের নাম
  names: {
    light: "Rabbit LED Light",
    necklace: "Men's Bar Necklace"
  }
};
/* ========================================================= */

const F = document.getElementById('orderForm');
const $ = id => document.getElementById(id);
const toastEl = $('toast');

function showToast(msg){
  toastEl.textContent = msg;
  toastEl.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => toastEl.classList.remove('show'), 2000);
}

function getQty(){
  let n = parseInt($('qty').value, 10);
  if (isNaN(n) || n < 1) n = 1;
  if (n > 99) n = 99;
  return n;
}

function getArea(){
  const el = F.querySelector('input[name="area"]:checked');
  return el ? el.value : 'inside';
}

function calc(){
  const product = $('product').value;
  const qty = getQty();
  const area = getArea();
  const unit = CONFIG.prices[product];
  const sub = unit * qty;
  const del = CONFIG.delivery[area];
  return { product, qty, area, unit, sub, del, total: sub + del };
}

function taka(n){ return '৳' + n; }

function updateSummary(){
  const c = calc();
  $('sProduct').textContent = CONFIG.names[c.product];
  $('sQty').textContent = c.qty + ' পিস';
  $('sSub').textContent = taka(c.sub);
  $('sDel').textContent = taka(c.del);
  $('sTotal').textContent = taka(c.total);
  if ($('qty').value !== String(c.qty)) $('qty').value = c.qty;
}

/* ---------- qty buttons ---------- */
$('plus').addEventListener('click', () => { $('qty').value = Math.min(99, getQty() + 1); updateSummary(); });
$('minus').addEventListener('click', () => { $('qty').value = Math.max(1, getQty() - 1); updateSummary(); });
$('qty').addEventListener('input', () => {
  $('qty').value = $('qty').value.replace(/[^\d]/g, '').slice(0, 2);
  updateSummary();
});

/* ---------- change listeners ---------- */
$('product').addEventListener('change', updateSummary);
F.querySelectorAll('input[name="area"]').forEach(r => r.addEventListener('change', updateSummary));

/* ---------- Product order buttons ---------- */
document.querySelectorAll('[data-order]').forEach(btn => {
  btn.addEventListener('click', () => {
    $('product').value = btn.dataset.order;
    updateSummary();
    $('order').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

/* ---------- validation + submit ---------- */
function showError(msg){
  const box = $('formErr');
  box.innerHTML = msg;
  box.classList.add('show');
  box.scrollIntoView({ behavior: 'smooth', block: 'center' });
}
function hideError(){ $('formErr').classList.remove('show'); }

F.addEventListener('submit', (e) => {
  e.preventDefault();
  hideError();

  const name = $('cname').value.trim();
  const phoneRaw = $('phone').value.trim();
  const phone = phoneRaw.replace(/[\s\-()]/g, '');
  const address = $('address').value.trim();
  const c = calc();

  const errors = [];
  if (name.length < 3) errors.push('• আপনার নাম লিখুন (কমপক্ষে ৩ অক্ষর)।');
  if (!/^01[3-9]\d{8}$/.test(phone)) errors.push('• সঠিক ১১ ডিজিটের মোবাইল নম্বর দিন (যেমন: 01712345678)।');
  if (address.length < 10) errors.push('• সম্পূর্ণ ঠিকানা লিখুন (বাসা/রোড, থানা, জেলা)।');

  if (errors.length) {
    showError('<strong>একটু ঠিক করে দিন:</strong><br>' + errors.join('<br>'));
    return;
  }

  const areaLabel = c.area === 'inside' ? 'Inside Dhaka' : 'Outside Dhaka';

  const text =
`🛒 নতুন অর্ডার — Rabbit Light & Bar Necklace

পণ্য: ${CONFIG.names[c.product]}
পরিমাণ: ${c.qty} পিস
একক দাম: ${c.unit} টাকা
সাবটোটাল: ${c.sub} টাকা
ডেলিভারি: ${areaLabel} — ${c.del} টাকা
সর্বমোট: ${c.total} টাকা

নাম: ${name}
মোবাইল: ${phone}
ঠিকানা: ${address}

পেমেন্ট: Cash on Delivery (COD)
ওয়ারেন্টি: নেই`;

  $('orderText').value = text;

  const waUrl = 'https://wa.me/' + CONFIG.whatsapp + '?text=' + encodeURIComponent(text);
  $('waBtn').href = waUrl;

  $('msgBtn').href = CONFIG.messenger;

  $('result').classList.add('show');
  $('result').scrollIntoView({ behavior: 'smooth', block: 'center' });
  showToast('অর্ডার তৈরি হয়েছে ✅');
});

/* ---------- copy ---------- */
$('copyBtn').addEventListener('click', async () => {
  const ta = $('orderText');
  try {
    await navigator.clipboard.writeText(ta.value);
    showToast('কপি হয়েছে ✅');
  } catch {
    ta.select();
    document.execCommand('copy');
    showToast('কপি হয়েছে ✅');
  }
});

/* ---------- links ---------- */
$('floatWa').href = 'https://wa.me/' + CONFIG.whatsapp;
$('footWa').href = 'https://wa.me/' + CONFIG.whatsapp;
$('footMsg').href = CONFIG.messenger;
$('year').textContent = new Date().getFullYear();

/* ---------- init ---------- */
updateSummary();
</script>
</body>
