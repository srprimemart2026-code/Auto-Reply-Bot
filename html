<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rabbit LED Light & Men's Bar Necklace | অর্ডার করুন</title>
<meta name="description" content="Rabbit LED Light এবং Men's Bar Necklace মাত্র ২০০ টাকায়। Cash on Delivery, Allover Bangladesh.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#fffdf7;
    --ink:#0f172a;
    --muted:#5b6478;
    --card:#ffffff;
    --accent:#f59e0b;
    --accent-dark:#b45309;
    --line:#ece6d8;
    --ok:#15803d;
    --danger:#dc2626;
    --radius:18px;
    --shadow:0 10px 30px rgba(15,23,42,.08);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;
    font-family:'Hind Siliguri',system-ui,-apple-system,'Segoe UI',sans-serif;
    background:var(--bg);
    color:var(--ink);
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1080px;margin:0 auto;padding:0 18px}
  h1,h2,h3{line-height:1.35;margin:0 0 8px}
  h2{font-size:clamp(22px,3.4vw,30px)}
  p{margin:0 0 12px}
  a{color:inherit}
  .muted{color:var(--muted)}

  /* ---------- Header ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,253,247,.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 0;flex-wrap:wrap}
  .brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:18px}
  .brand .dot{
    width:34px;height:34px;border-radius:10px;display:grid;place-items:center;
    background:linear-gradient(135deg,var(--accent),#fb923c);color:#fff;font-size:18px;
    box-shadow:0 6px 16px rgba(245,158,11,.35);
  }
  .nav-links{display:flex;gap:6px;flex-wrap:wrap}
  .nav-links a{
    text-decoration:none;font-size:14px;font-weight:500;color:var(--muted);
    padding:7px 12px;border-radius:999px;transition:.18s;
  }
  .nav-links a:hover{background:#fff4dd;color:var(--accent-dark)}

  /* ---------- Buttons ---------- */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    font-family:inherit;font-size:15px;font-weight:600;cursor:pointer;
    padding:12px 20px;border-radius:12px;border:1px solid transparent;
    text-decoration:none;transition:transform .12s, box-shadow .18s, background .18s;
  }
  .btn:active{transform:translateY(1px)}
  .btn-primary{background:linear-gradient(135deg,var(--accent),#fb923c);color:#fff;box-shadow:0 8px 20px rgba(245,158,11,.35)}
  .btn-primary:hover{box-shadow:0 12px 26px rgba(245,158,11,.45)}
  .btn-dark{background:var(--ink);color:#fff}
  .btn-dark:hover{background:#1e293b}
  .btn-ghost{background:#fff;color:var(--ink);border-color:var(--line)}
  .btn-ghost:hover{background:#fffaf0}
  .btn-sm{padding:9px 14px;font-size:14px;border-radius:10px}

  /* ---------- Hero ---------- */
  .hero{padding:46px 0 30px}
  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:34px;align-items:center}
  .pill{
    display:inline-block;background:#fff4dd;color:var(--accent-dark);
    font-size:13px;font-weight:600;padding:6px 14px;border-radius:999px;margin-bottom:14px;
  }
  .hero h1{font-size:clamp(27px,4.6vw,42px);letter-spacing:-.5px}
  .hero h1 span{color:var(--accent-dark)}
  .hero .lead{font-size:17px;color:var(--muted);max-width:46ch}
  .hero-cta{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0 16px}
  .badges{display:flex;gap:8px;flex-wrap:wrap}
  .badge{
    font-size:13px;font-weight:500;background:#fff;border:1px solid var(--line);
    padding:7px 13px;border-radius:999px;color:var(--muted);
  }
  .hero-art{
    position:relative;border-radius:26px;padding:26px;
    background:radial-gradient(circle at 30% 20%,#ffe9bd,#ffd88a 45%,#fbbf24);
    box-shadow:var(--shadow);min-height:250px;
    display:grid;place-items:center;gap:10px;text-align:center;
  }
  .hero-art .big{font-size:clamp(52px,10vw,86px);line-height:1;filter:drop-shadow(0 10px 14px rgba(180,83,9,.25))}
  .hero-art .tag{
    background:#fff;color:var(--accent-dark);font-weight:700;font-size:14px;
    padding:8px 16px;border-radius:999px;box-shadow:0 6px 16px rgba(180,83,9,.18);
  }

  /* ---------- Section ---------- */
  section{padding:36px 0}
  .sec-head{text-align:center;margin-bottom:26px}
  .sec-head p{color:var(--muted);max-width:56ch;margin:0 auto}

  /* ---------- Products ---------- */
  .products{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:22px}
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    box-shadow:var(--shadow);overflow:hidden;display:flex;flex-direction:column;
  }
  .thumb{
    height:210px;display:grid;place-items:center;position:relative;
    background:linear-gradient(135deg,#fff1cf,#ffe0a3);
  }
  .thumb.alt{background:linear-gradient(135deg,#e6f0ff,#cfe0ff)}
  .thumb .emoji{font-size:76px;filter:drop-shadow(0 8px 12px rgba(15,23,42,.16))}
  .thumb img{width:100%;height:100%;object-fit:cover}
  .thumb .code{
    position:absolute;top:12px;left:12px;background:rgba(255,255,255,.92);
    font-size:12px;font-weight:700;color:var(--accent-dark);padding:5px 11px;border-radius:999px;
  }
  .p-body{padding:18px;display:flex;flex-direction:column;gap:6px;flex:1}
  .p-body h3{font-size:19px}
  .price{font-size:24px;font-weight:700;color:var(--accent-dark)}
  .price small{font-size:13px;font-weight:500;color:var(--muted);margin-left:6px}
  .p-body ul{margin:6px 0 12px;padding-left:0;list-style:none;font-size:14px;color:var(--muted)}
  .p-body ul li{padding-left:20px;position:relative}
  .p-body ul li::before{content:"✓";position:absolute;left:0;color:var(--ok);font-weight:700}
  .p-body .btn{margin-top:auto;width:100%}

  /* ---------- Features ---------- */
  .features{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
  .feat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px}
  .feat .ico{font-size:24px;display:block;margin-bottom:6px}
  .feat h3{font-size:16px;margin-bottom:2px}
  .feat p{font-size:14px;color:var(--muted);margin:0}

  /* ---------- Delivery ---------- */
  .delivery-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
  .dbox{background:#fff;border:1px solid var(--line);border-radius:16px;padding:20px;text-align:center}
  .dbox .num{font-size:28px;font-weight:700;color:var(--accent-dark)}
  .dbox .lbl{font-size:14px;color:var(--muted)}

  /* ---------- Order Form ---------- */
  .order-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:22px;align-items:start}
  .panel{
    background:#fff;border:1px solid var(--line);border-radius:var(--radius);
    padding:22px;box-shadow:var(--shadow);
  }
  .field{margin-bottom:14px}
  .field label{display:block;font-size:14px;font-weight:600;margin-bottom:5px}
  .field .hint{font-weight:400;font-size:12px;color:var(--muted)}
  input[type=text],input[type=tel],textarea,select{
    width:100%;font-family:inherit;font-size:15px;color:var(--ink);
    padding:11px 13px;border:1px solid #ddd6c6;border-radius:11px;background:#fffdf8;
    transition:border .15s, box-shadow .15s;
  }
  input:focus,textarea:focus,select:focus{
    outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(245,158,11,.18);background:#fff;
  }
  textarea{min-height:78px;resize:vertical}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .qty-box{display:flex;align-items:center;gap:8px}
  .qty-box button{
    width:40px;height:42px;border-radius:11px;border:1px solid #ddd6c6;background:#fff;
    font-size:19px;font-weight:700;color:var(--ink);cursor:pointer;font-family:inherit;
  }
  .qty-box button:hover{background:#fff4dd;border-color:var(--accent)}
  .qty-box input{text-align:center}
  .radios{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .radio{
    display:flex;align-items:center;gap:8px;border:1px solid #ddd6c6;border-radius:11px;
    padding:11px 13px;cursor:pointer;font-size:14px;background:#fffdf8;transition:.15s;
  }
  .radio:has(input:checked){border-color:var(--accent);background:#fff7e6;box-shadow:0 0 0 3px rgba(245,158,11,.12)}
  .radio input{accent-color:var(--accent);width:16px;height:16px}
  .radio span{font-weight:600}

  .summary{background:#fffaf0;border:1px dashed #f0c987;border-radius:14px;padding:16px}
  .summary h3{font-size:16px;margin-bottom:10px}
  .srow{display:flex;justify-content:space-between;font-size:14.5px;padding:5px 0;color:var(--muted)}
  .srow strong{color:var(--ink);font-weight:600}
  .srow.total{border-top:1px solid #f0c987;margin-top:8px;padding-top:10px;font-size:17px;color:var(--ink);font-weight:700}
  .srow.total strong{color:var(--accent-dark);font-size:19px}

  .err{
    display:none;background:#fee2e2;color:#991b1b;border:1px solid #fecaca;
    border-radius:11px;padding:11px 14px;font-size:14px;margin-bottom:14px;
  }
  .err.show{display:block}

  /* ---------- Result ---------- */
  #result{display:none;margin-top:22px}
  #result.show{display:block}
  #orderText{
    width:100%;min-height:190px;font-family:inherit;font-size:14px;line-height:1.8;
    background:#f8fafc;border:1px solid var(--line);border-radius:12px;padding:14px;
  }
  .result-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
  .ok-note{color:var(--ok);font-weight:600;font-size:14px;margin-bottom:10px}

  /* ---------- FAQ ---------- */
  .faq{max-width:760px;margin:0 auto}
  details{
    background:#fff;border:1px solid var(--line);border-radius:14px;
    padding:14px 18px;margin-bottom:10px;
  }
  details[open]{border-color:#f0c987;background:#fffdf6}
  summary{
    cursor:pointer;font-weight:600;font-size:15.5px;list-style:none;
    display:flex;justify-content:space-between;gap:12px;align-items:center;
  }
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";font-size:20px;color:var(--accent-dark);font-weight:700}
  details[open] summary::after{content:"–"}
  details p{margin:10px 0 0;font-size:14.5px;color:var(--muted)}

  /* ---------- Footer ---------- */
  footer{background:#0f172a;color:#cbd5e1;padding:34px 0 26px;margin-top:20px}
  .foot-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px}
  footer h4{color:#fff;font-size:15px;margin:0 0 8px}
  footer p,footer a{font-size:14px;color:#94a3b8;text-decoration:none}
  footer a:hover{color:var(--accent)}
  .foot-bottom{
    border-top:1px solid #1e293b;margin-top:24px;padding-top:16px;
    text-align:center;font-size:13px;color:#64748b;
  }
  .foot-links{display:flex;flex-direction:column;gap:6px}

  /* ---------- Floating WhatsApp ---------- */
  .float{
    position:fixed;right:16px;bottom:16px;z-index:60;
    display:flex;align-items:center;gap:9px;
    background:#25D366;color:#fff;text-decoration:none;font-weight:600;font-size:14px;
    padding:12px 18px;border-radius:999px;box-shadow:0 10px 26px rgba(37,211,102,.45);
  }
  .float:hover{background:#1eb457}

  /* ---------- Toast ---------- */
  #toast{
    position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);
    background:var(--ink);color:#fff;font-size:14px;padding:11px 20px;border-radius:999px;
    opacity:0;pointer-events:none;transition:.25s;z-index:99;
  }
  #toast.show{opacity:1;transform:translate(-50%,0)}

  /* ---------- Responsive ---------- */
  @media(max-width:860px){
    .hero-grid,.order-grid{grid-template-columns:1fr}
    .hero-art{order:-1;min-height:190px}
    .hero{padding:28px 0 16px}
  }
  @media(max-width:520px){
    .row2,.radios{grid-template-columns:1fr}
    .float span{display:none}
    .float{padding:15px;font-size:20px}
  }
</style>
</head>
<body>

<header>
  <div class="wrap nav">
    <div class="brand">
      <span class="dot">🛍️</span>
      <span>Rabbit Light &amp; Bar Necklace</span>
    </div>
    <nav class="nav-links">
