      <div class="hero-cta">
        <a href="#order" class="btn btn-primary">🛒 এখনই অর্ডার করুন</a>
        <a href="#products" class="btn btn-ghost">প্রোডাক্ট দেখুন</a>
      </div>
      <div class="badges">
        <span class="badge">✅ ১০০% অরিজিনাল</span>
        <span class="badge">💵 ক্যাশ অন ডেলিভারি</span>
        <span class="badge">🚚 ঢাকায় ৭০৳</span>
      </div>
    </div>
    <div class="hero-art">
      <div class="big">🐰💡</div>
      <div class="tag">প্রতিটি মাত্র ৳২০০</div>
    </div>
  </div>
</div>

<!-- PRODUCTS -->
<section id="products">
  <div class="wrap">
    <div class="sec-head">
      <h2>আমাদের প্রোডাক্ট</h2>
      <p>দুটো প্রোডাক্টই একদম ফিক্সড প্রাইসে — ২০০ টাকা।</p>
    </div>
    <div class="products">

      <!-- Product 1 -->
      <article class="card">
        <div class="thumb">
          <span class="code">Rabbit</span>
          <!-- চাইলে এই span মুছে দিন এবং নিচের লাইনটি দিন:
               <img src="light.jpg" alt="Rabbit LED Light"> -->
          <span class="emoji">🐰💡</span>
        </div>
        <div class="p-body">
          <h3>Rabbit LED Light</h3>
          <div class="price">৳২০০ <small>প্রতিটি</small></div>
          <ul>
            <li>সুন্দর ও আকর্ষণীয় ডিজাইন</li>
            <li>ডেকোরেশন / নাইট লাইট হিসেবে পারফেক্ট</li>
            <li>স্টক সাপেক্ষে ডেলিভারি</li>
          </ul>
          <button class="btn btn-primary" data-order="light">অর্ডার করুন</button>
        </div>
      </article>

      <!-- Product 2 -->
      <article class="card">
        <div class="thumb alt">
          <span class="code">Necklace</span>
          <!-- চাইলে এই span মুছে দিন এবং নিচের লাইনটি দিন:
               <img src="necklace.jpg" alt="Men's Bar Necklace"> -->
          <span class="emoji">📿</span>
        </div>
        <div class="p-body">
          <h3>Men's Bar Necklace</h3>
          <div class="price">৳২০০ <small>প্রতিটি</small></div>
          <ul>
            <li>ছেলেদের জন্য স্টাইলিশ বার নেকলেস</li>
            <li>রেগুলার ব্যবহারের জন্য মানসম্মত</li>
            <li>গিফট হিসেবেও চমৎকার</li>
          </ul>
          <button class="btn btn-primary" data-order="necklace">অর্ডার করুন</button>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- FEATURES -->
<section>
  <div class="wrap features">
    <div class="feat">
      <span class="ico">💵</span>
      <h3>ক্যাশ অন ডেলিভারি</h3>
      <p>পণ্য হাতে পাওয়ার পর টাকা পরিশোধ করবেন।</p>
    </div>
    <div class="feat">
      <span class="ico">🚚</span>
      <h3>সারা দেশে ডেলিভারি</h3>
      <p>Inside Dhaka ৭০৳, Outside Dhaka ১৩০৳।</p>
    </div>
    <div class="feat">
      <span class="ico">🏷️</span>
      <h3>ফিক্সড প্রাইস</h3>
      <p>দাম ২০০ টাকা — কোনো ছাড় নেই।</p>
    </div>
    <div class="feat">
      <span class="ico">📞</span>
      <h3>সাপোর্ট</h3>
      <p>অর্ডার সংক্রান্ত যেকোনো প্রশ্নে যোগাযোগ করুন।</p>
    </div>
  </div>
</section>

<!-- DELIVERY -->
<section id="delivery">
  <div class="wrap">
    <div class="sec-head">
      <h2>ডেলিভারি চার্জ</h2>
      <p>আমরা সারা বাংলাদেশে ডেলিভারি করি। পেমেন্ট সম্পূর্ণ ক্যাশ অন ডেলিভারি।</p>
    </div>
    <div class="delivery-grid">
      <div class="dbox">
        <div class="num">৳৭০</div>
        <div class="lbl">Inside Dhaka</div>
      </div>
      <div class="dbox">
        <div class="num">৳১৩০</div>
        <div class="lbl">Outside Dhaka</div>
      </div>
      <div class="dbox">
        <div class="num">COD</div>
        <div class="lbl">Cash on Delivery</div>
      </div>
    </div>
  </div>
</section>

<!-- ORDER -->
<section id="order" style="background:#fffaf0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap">
    <div class="sec-head">
      <h2>অর্ডার করুন</h2>
      <p>ফর্মটি পূরণ করুন — নিচে আপনার অর্ডারের ডিটেইলস তৈরি হবে, সেটি কপি করে আমাদের পাঠান।</p>
    </div>

    <div class="order-grid">
      <!-- FORM -->
      <div class="panel">
        <form id="orderForm" novalidate>

          <div id="formErr" class="err"></div>

          <div class="field">
            <label for="product">পণ্য</label>
            <select id="product">
              <option value="light">Rabbit LED Light — ৳২০০</option>
              <option value="necklace">Men's Bar Necklace — ৳২০০</option>
            </select>
          </div>

          <div class="row2">
            <div class="field">
              <label for="qty">পরিমাণ</label>
              <div class="qty-box">
                <button type="button" id="minus" aria-label="কমান">−</button>
                <input type="text" id="qty" value="1" inputmode="numeric">
                <button type="button" id="plus" aria-label="বাড়ান">+</button>
              </div>
            </div>
            <div class="field">
              <label for="cname">আপনার নাম</label>
              <input type="text" id="cname" placeholder="যেমন: রফিকুল ইসলাম">
            </div>
          </div>

